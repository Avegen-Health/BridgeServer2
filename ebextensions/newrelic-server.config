packages:
  yum:
    # newrelic-sysmond is deprecated/EOL. Removing.
    curl: [] 

container_commands:
  "01SetLicenseKey":
    # Metadata set for the sysmond legacy tool is removed.
    command: "echo 'Setting up New Relic...'"
  "03InstallNRApmAgent":
    command: "/bin/mkdir -p /usr/local/lib/newrelic && curl -L https://download.newrelic.com/newrelic/java-agent/newrelic-agent/8.21.0/newrelic-agent-8.21.0.jar -o /usr/local/lib/newrelic/newrelic-agent.jar"
  "04CopyNRConfig":
    # Try to copy, but don't fail if missing to allow debug. Ideally this is in the WAR.
    command: "cp -rf /var/app/staging/WEB-INF/classes/newrelic.yml /etc/newrelic.yml || echo 'Config not found in staging'"
  "05SetNRLicenseKey":
    command: "echo -e \"\n  license_key: $NEW_RELIC_LICENSE_KEY\" >> /etc/newrelic.yml"
  "06SetNRAppName":
    command: "echo -e \"\n  app_name: $NEW_RELIC_APP_NAME\" >> /etc/newrelic.yml"
  "07SetNRJVMInstanceId":
    command: 'export INSTANCE_ID=$(curl --silent http://169.254.169.254/latest/meta-data/instance-id) && echo -e "\n  process_host:\n    display_name: $INSTANCE_ID" >> /etc/newrelic.yml'

# Setup NR infrastructure agent config
  "10CopyNRInfraConfig":
    command: "cp -rf /var/app/staging/WEB-INF/classes/newrelic-infra.yml /etc/newrelic-infra.yml || echo 'Infra config not found'"
  "11SetNRInfraLicenseKey":
    command: "echo -e \"license_key: $NEW_RELIC_LICENSE_KEY\" >> /etc/newrelic-infra.yml"
  "12SetNRInfraDisplayName":
    command: "echo -e \"\ndisplay_name: $NEW_RELIC_APP_NAME\" >> /etc/newrelic-infra.yml"
  "13SetupInfraAgentRepo":
    command: sudo curl -o /etc/yum.repos.d/newrelic-infra.repo https://download.newrelic.com/infrastructure_agent/linux/yum/amazonlinux/2/x86_64/newrelic-infra.repo
  "14UpdateInfraAgentYumCache":
    command: yum -q makecache -y --disablerepo='*' --enablerepo='newrelic-infra'
  "20InstallInfraAgent":
    command: sudo yum install newrelic-infra -y
